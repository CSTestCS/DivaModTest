<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>VRoidDiva</AssemblyName>
    <RootNamespace>VRoidDiva.App</RootNamespace>
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>

  <!-- Referenced directly instead of UseWindowsForms so it also builds with SDKs
       that lack the Windows desktop targets (e.g. Linux distribution packages). -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
    <Using Include="System.Drawing" />
    <Using Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VRoidDiva\VRoidDiva.csproj" />
  </ItemGroup>

</Project>
